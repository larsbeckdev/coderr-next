# Copy this file to `.env.local` and adjust the values.
# Every value has a development fallback in core/settings.py, so the project
# also runs without this file.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to call this API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
